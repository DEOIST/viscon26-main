# Local development: copy this file to backend/.env, then run docker compose up --build.
# Additional database, AI, and camera settings are listed in backend/.env.example.
# Keep real .env files private; never commit credentials.

APP_NAME="ETH Life"
ENVIRONMENT=development

# on: enable "Preview graduation" without completing games or changing results.
# off: keep normal graduation eligibility. Recreate the backend container after changing it.
GRADUATION_PREVIEW=off

# off: no AI calls; fake: canned responses; live: real API calls.
AI_MODE=off
OPENAI_API_KEYS=

# Docker supplies PostgreSQL and Redis connection settings automatically.
# For a backend started directly, optionally configure these:
# DATABASE_URL=
# REDIS_URL=
