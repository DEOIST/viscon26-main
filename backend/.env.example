# Copy to backend/.env and adjust. Never commit .env; this file lists names, never real values.
APP_NAME="ETH Life"
ENVIRONMENT=development
# UI-only graduation/diploma preview for testing; does not complete games or submit a result.
# Toggle on/off (also accepts true/false), then restart the backend (recreate its Docker container).
GRADUATION_PREVIEW=off

# Redis. Empty: an in-process fakeredis whose data resets on every reload.
# With `make redis`: REDIS_URL=redis://localhost:6379/0. Compose sets it in production.
REDIS_URL=

# PostgreSQL stores anonymous player profiles and the ECTS leaderboard. Compose sets these.
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=eth_simulator
POSTGRES_USER=eth_dev
POSTGRES_PASSWORD=
# The page's own origin may always request an AI avatar suggestion, on any domain.
# Optional comma-separated extra origins (other hosts, e.g. the Vite dev server):
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# OpenAI, see docs/ARCHITECTURE.md → "OpenAI integration".
# off: no calls, pre-written content (default) · fake: canned content, no calls · live: real calls
AI_MODE=off
# Comma-separated failover chain (key1,key2,key3). Check them for free with `make ai-check`.
OPENAI_API_KEYS=

# Optional overrides (defaults shown):
# OPENAI_TEXT_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=none
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=cedar
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_VISION_MODEL=gpt-5.6-luna
# OPENAI_TIMEOUT_SECONDS=12
# AI_DAILY_CALL_LIMIT=3000

# Level 1, the finger-detection engine (backend/level1/, docs/SHOOTER_CV.md). Optional overrides
# (defaults shown): players tracked at once (each costs about one CPU core), the largest camera
# frame accepted, and how long a stream may send nothing (a hidden tab) before it is closed.
# CV_MAX_SESSIONS=4
# CV_MAX_FRAME_BYTES=200000
# CV_IDLE_TIMEOUT_SECONDS=20
# The hand model; by default the one the frontend build downloads (dist/, else public/models/).
# CV_MODEL_PATH=
