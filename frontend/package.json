{
    "name": "frontend",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "tsc --noEmit && node build.js --prod && vite build",
        "test": "vitest run",
        "preview": "vite preview --host 0.0.0.0",
        "build:legacy": "node build.js --prod",
        "dev:legacy": "node build.js -w",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "check": "tsc --noEmit && prettier --check ."
    },
    "dependencies": {
        "@mediapipe/tasks-vision": "^1.1.0",
        "@reduxjs/toolkit": "2.9.0",
        "phaser": "^4.2.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-redux": "9.2.0"
    },
    "devDependencies": {
        "@testing-library/dom": "10.4.1",
        "@testing-library/react": "16.3.0",
        "@types/node": "22.18.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "4.7.0",
        "esbuild": "^0.28.2",
        "jsdom": "26.1.0",
        "prettier": "^3.9.9",
        "typescript": "^7.0.2",
        "vite": "6.4.4",
        "vitest": "4.1.11"
    }
}
