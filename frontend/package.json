{
    "name": "frontend",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=26.5.0"
    },
    "scripts": {
        "dev": "node build.js -w",
        "build": "node build.js --prod",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "check": "tsc --noEmit && prettier --check . && vitest run",
        "test": "vitest run"
    },
    "dependencies": {
        "phaser": "^4.2.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "esbuild": "^0.28.2",
        "prettier": "^3.9.9",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    }
}
