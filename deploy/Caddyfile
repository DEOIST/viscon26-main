# HTTPS in front of the app on the VIScon VM's direct address. The hackathon's managed proxy
# does not support WebSockets, and level 1 streams camera frames over one (/api/cv/stream),
# so the VM serves itself ("Ingress mode: Custom"). With SITE_ADDRESS set to the VM's domain,
# Caddy gets and renews a Let's Encrypt certificate on its own; it needs ports 80 and 443 open
# (sudo ufw allow 80,443/tcp). Locally it serves https://localhost with a self-signed one.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip
	# Vite proxies /api (including the WebSocket) to the backend.
	reverse_proxy frontend:5173
}
